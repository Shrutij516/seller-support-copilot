# Copy to .env and adjust. Never commit real secrets.

# services/api
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
# DynamoDB Local only; leave unset in AWS so boto3 talks to the real regional endpoint.
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_REGION=us-east-1
# Local-only dummy values: DynamoDB Local doesn't check them, but boto3 refuses to sign
# requests without something present. Never put real AWS keys here.
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
READINESS_TIMEOUT_SECONDS=2.0
CORS_ALLOW_ORIGINS=http://localhost:3000

# Cognito (phase 3). Not secrets (a public SPA client has none), but still per-environment
# config, so it stays out of git like everything else here. Get these from the user pool
# and app client in the AWS console.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx/.well-known/jwks.json
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres container (local only)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot

# apps/web has its own .env.example (NEXT_PUBLIC_API_BASE_URL).
