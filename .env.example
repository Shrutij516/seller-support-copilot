# Copy to .env and adjust. Never commit real secrets.

# services/api
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0
READINESS_TIMEOUT_SECONDS=2.0
CORS_ALLOW_ORIGINS=http://localhost:3000

# Postgres container (local only)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot

# apps/web has its own .env.example (NEXT_PUBLIC_API_BASE_URL).
